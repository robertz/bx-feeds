/**
 * Fetches a feed over http(s) and parses it, with a conditional GET so an
 * unchanged feed costs one small request:
 *
 *   result = new bxModules.bxFeeds.models.FeedFetcher().fetch( feedUrl, { etag: saved.etag, lastModified: saved.lastModified } )
 *   // { status, notModified, etag, lastModified, finalUrl, permanentUrl, contentType, retryAfterSeconds, maxAgeSeconds,
 *   //   links, challenged, paused, feed, body }
 *
 * feed is the FeedParser struct on a 200 and null otherwise (304, 404, 500...).
 *
 * Three things are done for sites that make fetching hard. One that refuses the
 * User-Agent (401 or 403) is asked again as each of fallbackUserAgents, and the
 * one it accepts is remembered for that host. A refusal that is a bot check (a
 * CAPTCHA page no fetch can pass) is reported as challenged. And a site that
 * answers a feed fetch with 429 is left alone for a while: until then fetches of
 * its feeds return a 429 marked paused without asking it. What's remembered is
 * kept in memory, for every fetcher in this BoxLang runtime.
 *
 * Redirects are followed by hand so permanent ones can be reported, and every
 * hop must be a public address unless allowPrivateAddresses is set. A network
 * failure throws Feeds.FetchError, or its subtypes Feeds.FetchError.Timeout,
 * .TooLarge, .TooManyRedirects and .PrivateAddress; a 200 that isn't a feed
 * throws Feeds.ParseError.
 */
class {

	property name="settings";

	static {
		ACCEPT = "application/feed+json, application/atom+xml, application/rss+xml, application/xml;q=0.9, text/xml;q=0.8, */*;q=0.5"
		REDIRECTS = [ 301, 302, 303, 307, 308 ]
		REFUSED = [ 401, 403 ]
		// a refusal that may be a bot check: the start of the page is read to tell
		CHECKED = [ 401, 403, 429, 503 ]
		CHECK_BYTES = 65536
		// Cloudflare's interstitials, and the CAPTCHA widgets of it, DataDome, PerimeterX, reCAPTCHA and hCaptcha
		CHALLENGE = "<title>\s*(just a moment|attention required!? \| cloudflare)|challenge-platform|cf-chl-|cf_chl_|captcha-delivery\.com|px-captcha|g-recaptcha|h-captcha|hcaptcha\.com"
		// how long a site that answered 429 is left alone when it doesn't say, and at most when it does
		PAUSE_SECONDS = 900
		MAX_RETRY_AFTER = 3600
		// when it doesn't say, each 429 in a row doubles PAUSE_SECONDS (15, 30, 60, 120 minutes), up to this
		MAX_PAUSE_SECONDS = 14400
		// second-level labels under a country code that are a registry's, not a site's (bbc.co.uk)
		REGISTRY_LABELS = [ "ac", "co", "com", "edu", "gov", "net", "org" ]
		// host -> the fallback User-Agent it accepted
		HOST_AGENTS = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		// site (siteOf) -> epoch ms until which it's left alone
		PAUSED = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		// site -> 429s in a row, until a fetch gets through
		REFUSALS = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		LINK = createObject( "java", "java.util.regex.Pattern" ).compile( "<([^>]*)>([^,<]*)" )
		LINK_REL = createObject( "java", "java.util.regex.Pattern" ).compile( "(?i);\s*rel\s*=\s*(?:""([^""]*)""|([^;\s]+))" )
	}

	/** overrides: any of the module's settings (see the README's Settings table). */
	function init( struct overrides = {} ) {
		variables.settings = duplicate( getModuleInfo( "bxFeeds" ).settings ).append( arguments.overrides )
		variables.parser = new FeedParser()
		return this
	}

	/**
	 * options: { etag, lastModified: from the last fetch's result, sent as If-None-Match and
	 *            If-Modified-Since; parse: false to get a 200's bytes in body instead of a feed;
	 *            accept: an Accept header for something other than a feed;
	 *            any of the module's settings, for this call;
	 *            httpOnly, collapseRevisions, dropEmptyItems, maxItems: passed on to the parser }
	 * timeoutSeconds covers the whole fetch: every User-Agent tried, redirects
	 * and body included; maxBytes counts the body after gzip is undone.
	 */
	struct function fetch( required string feedUrl, struct options = {} ) {
		var config = duplicate( variables.settings ).append( arguments.options )
		var deadline = getTickCount() + config.timeoutSeconds * 1000
		var address = trim( arguments.feedUrl )
		// a 429 for a page or an image says nothing about the site's feeds, so only feed fetches count
		var pausing = ( config.pauseAfter429 ?: true ) && ( config.parse ?: true )
		var wait = pausing ? pausedSeconds( address ) : 0
		if ( wait > 0 ) {
			return {
				status : 429, notModified : false, etag : "", lastModified : "", finalUrl : address, permanentUrl : "", contentType : "",
				retryAfterSeconds : wait, maxAgeSeconds : 0, links : [], challenged : false, paused : true,
				feed : javacast( "null", "" ), body : javacast( "null", "" )
			}
		}
		var flaky = isStruct( config.retryNotFound ?: "" ) ? config.retryNotFound : {}
		var delays = len( flaky.pattern ?: "" ) && reFindNoCase( flaky.pattern, address ) ? ( flaky.delaysMs ?: [] ) : []
		var result = fetchAs( address, config, deadline, arguments.options )
		for ( var delay in delays ) {
			if ( result.status != 404 ) {
				break
			}
			sleep( min( delay, remainingMs( deadline ) ) )
			result = fetchAs( address, config, deadline, arguments.options )
		}
		if ( pausing ) {
			noteRateLimit( address, result )
		}
		return result
	}

	/** One fetch, as the User-Agent the host last accepted, then as the others if it's refused. */
	private struct function fetchAs( required string address, required struct config, required numeric deadline, required struct options ) {
		var host = hostOf( arguments.address )
		var agents = [ static.HOST_AGENTS.getOrDefault( host, arguments.config.userAgent ) ]
		for ( var agent in [ arguments.config.userAgent ].append( arguments.config.fallbackUserAgents ?: [], true ) ) {
			if ( !agents.contains( agent ) ) {
				agents.append( agent )
			}
		}
		var result = {}
		for ( var agent in agents ) {
			result = fetchOnce( arguments.address, duplicate( arguments.config ).append( { userAgent: agent } ), arguments.deadline, arguments.options )
			// a bot check refuses every User-Agent alike
			if ( result.challenged ) {
				break
			}
			if ( !static.REFUSED.contains( result.status ) ) {
				if ( len( host ) && agent != arguments.config.userAgent ) {
					static.HOST_AGENTS.put( host, agent )
				} else if ( len( host ) ) {
					static.HOST_AGENTS.remove( host )
				}
				break
			}
		}
		return result
	}

	private struct function fetchOnce( required string address, required struct config, required numeric deadline, required struct options ) {
		var config = arguments.config
		var deadline = arguments.deadline
		var current = arguments.address
		var permanentUrl = ""
		var onlyPermanent = true
		for ( var hop = 0; hop <= config.maxRedirects; hop++ ) {
			var connection = open( current, config, deadline )
			try {
				var status = overNetwork( () => connection.getResponseCode() )
				var location = trim( connection.getHeaderField( "Location" ) ?: "" )
				if ( static.REDIRECTS.contains( status ) && len( location ) ) {
					current = withoutDefaultPort( variables.parser.resolveUrl( location, current ) )
					// a 301 or 308 moves the feed for good, but only until a temporary hop: what's behind that may change
					onlyPermanent = onlyPermanent && ( status == 301 || status == 308 )
					if ( onlyPermanent ) {
						permanentUrl = current
					}
					continue
				}
				var result = {
					status       : status,
					notModified  : status == 304,
					etag         : connection.getHeaderField( "ETag" ) ?: ( status == 304 ? ( config.etag ?: "" ) : "" ),
					lastModified : connection.getHeaderField( "Last-Modified" ) ?: ( status == 304 ? ( config.lastModified ?: "" ) : "" ),
					finalUrl     : current,
					permanentUrl : permanentUrl,
					contentType  : connection.getContentType() ?: "",
					retryAfterSeconds : retryAfter( connection.getHeaderField( "Retry-After" ) ?: "" ),
					maxAgeSeconds : maxAge( connection.getHeaderField( "Cache-Control" ) ?: "", connection.getHeaderField( "Expires" ) ?: "" ),
					links        : linksOf( connection, current ),
					challenged   : isChallenge( connection, status ),
					paused       : false,
					feed         : javacast( "null", "" ),
					body         : javacast( "null", "" )
				}
				if ( status == 200 && ( config.parse ?: true ) ) {
					// the parser's own options (httpOnly, collapseRevisions, dropEmptyItems, maxItems) pass through
					result.feed = variables.parser.parse( bodyOf( connection, config.maxBytes, deadline ), duplicate( arguments.options ).append( { baseUrl: current, contentType: result.contentType } ) )
				} else if ( status == 200 ) {
					result.body = bodyOf( connection, config.maxBytes, deadline )
				}
				return result
			} finally {
				connection.disconnect()
			}
		}
		throw( type = "Feeds.FetchError.TooManyRedirects", message = "More than #config.maxRedirects# redirects" )
	}

	/** Whether a refusal is a bot check: Cloudflare's own header, or the page's markers. */
	private boolean function isChallenge( required connection, required numeric status ) {
		if ( !static.CHECKED.contains( arguments.status ) ) {
			return false
		}
		if ( lcase( trim( arguments.connection.getHeaderField( "cf-mitigated" ) ?: "" ) ) == "challenge" ) {
			return true
		}
		try {
			var stream = arguments.connection.getErrorStream()
			if ( isNull( stream ) ) {
				return false
			}
			if ( lcase( arguments.connection.getContentEncoding() ?: "" ) == "gzip" ) {
				stream = createObject( "java", "java.util.zip.GZIPInputStream" ).init( stream )
			}
			var start = createObject( "java", "java.lang.String" ).init( stream.readNBytes( static.CHECK_BYTES ), "UTF-8" )
			stream.close()
			return reFindNoCase( static.CHALLENGE, start ) > 0
		} catch ( any e ) {
			return false
		}
	}

	/**
	 * After a feed fetch: a 429 leaves the site alone for a while, both the site
	 * asked and the one a redirect ended at; a 200 or 304 means it's through
	 * again, so the next 429 starts back at PAUSE_SECONDS.
	 */
	private void function noteRateLimit( required string address, required struct result ) {
		var sites = []
		for ( var site in [ siteOf( arguments.address ), siteOf( arguments.result.finalUrl ) ] ) {
			if ( len( site ) && !sites.contains( site ) ) {
				sites.append( site )
			}
		}
		for ( var site in sites ) {
			if ( arguments.result.status == 429 ) {
				var refused = static.REFUSALS.getOrDefault( site, 0 ) + 1
				var seconds = arguments.result.retryAfterSeconds > 0
					? min( arguments.result.retryAfterSeconds, static.MAX_RETRY_AFTER )
					: min( static.PAUSE_SECONDS * ( 2 ^ ( refused - 1 ) ), static.MAX_PAUSE_SECONDS )
				static.REFUSALS.put( site, refused )
				static.PAUSED.put( site, getTickCount() + seconds * 1000 )
			} else if ( arguments.result.status == 200 || arguments.result.status == 304 ) {
				static.REFUSALS.remove( site )
			}
		}
	}

	/** How many seconds the site at this address is still being left alone after a 429; 0 when it may be asked now. */
	numeric function pausedSeconds( required string address ) {
		var site = siteOf( arguments.address )
		var until = static.PAUSED.getOrDefault( site, 0 )
		if ( until == 0 ) {
			return 0
		}
		if ( until <= getTickCount() ) {
			static.PAUSED.remove( site )
			return 0
		}
		return ceiling( ( until - getTickCount() ) / 1000 )
	}

	/** The sites being left alone after a 429, soonest back first: [ { site, seconds, refusals } ]. */
	array function pausedSites() {
		var paused = []
		for ( var site in static.PAUSED.keySet().toArray() ) {
			var seconds = pausedSeconds( "http://" & site & "/" )
			if ( seconds > 0 ) {
				paused.append( { site: site, seconds: seconds, refusals: static.REFUSALS.getOrDefault( site, 0 ) } )
			}
		}
		paused.sort( ( a, b ) => sgn( a.seconds - b.seconds ) )
		return paused
	}

	/** Ends a site's pause now, keeping count of its 429s in a row: the next one still waits longer. */
	void function endPause( required string address ) {
		static.PAUSED.remove( siteOf( arguments.address ) )
	}

	/** Forgets the pauses and the User-Agents hosts accepted; one site's when an address is given. */
	void function forget( string address = "" ) {
		if ( !len( arguments.address ) ) {
			static.PAUSED.clear()
			static.REFUSALS.clear()
			static.HOST_AGENTS.clear()
			return
		}
		static.PAUSED.remove( siteOf( arguments.address ) )
		static.REFUSALS.remove( siteOf( arguments.address ) )
		static.HOST_AGENTS.remove( hostOf( arguments.address ) )
	}

	/** The site an address belongs to, for limits a site applies across its subdomains: x.tumblr.com is tumblr.com, news.bbc.co.uk is bbc.co.uk. */
	string function siteOf( required string address ) {
		var host = hostOf( arguments.address )
		if ( reFind( "^[0-9.]+$", host ) || find( ":", host ) ) {
			return host
		}
		var labels = listToArray( host, "." )
		var count = labels.len()
		var keep = count > 2 && len( labels[ count ] ) == 2 && static.REGISTRY_LABELS.contains( labels[ count - 1 ] ) ? 3 : 2
		return count > keep ? labels.slice( count - keep + 1, keep ).toList( "." ) : labels.toList( "." )
	}

	private string function hostOf( required string address ) {
		try {
			return lcase( createObject( "java", "java.net.URI" ).init( trim( arguments.address ) ).getHost() ?: "" )
		} catch ( any e ) {
			return ""
		}
	}

	/**
	 * A form POST, as WebSub's request to a hub is, with the same checks on the
	 * address as a fetch, the same timeout and User-Agent. Redirects aren't followed.
	 * @return { status, body: the first 2 KB of the answer as text }
	 */
	struct function postForm( required string targetUrl, required struct fields, struct options = {} ) {
		var config = duplicate( variables.settings ).append( arguments.options )
		var deadline = getTickCount() + config.timeoutSeconds * 1000
		var pairs = []
		for ( var name in arguments.fields ) {
			pairs.append( urlEncodedFormat( name ) & "=" & urlEncodedFormat( arguments.fields[ name ] ) )
		}
		var payload = pairs.toList( "&" ).getBytes( "UTF-8" )
		var connection = open( trim( arguments.targetUrl ), config, deadline )
		try {
			connection.setRequestMethod( "POST" )
			connection.setDoOutput( true )
			connection.setRequestProperty( "Content-Type", "application/x-www-form-urlencoded" )
			connection.setRequestProperty( "Accept", "*/*" )
			var status = overNetwork( () => {
				var out = connection.getOutputStream()
				out.write( payload )
				out.close()
				return connection.getResponseCode()
			} )
			var said = ""
			try {
				var stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream()
				if ( !isNull( stream ) ) {
					said = createObject( "java", "java.lang.String" ).init( stream.readNBytes( 2048 ), "UTF-8" )
					stream.close()
				}
			} catch ( any e ) {
				// the status is what matters
			}
			return { status: status, body: said }
		} finally {
			connection.disconnect()
		}
	}

	private function open( required string target, required struct config, required numeric deadline ) {
		if ( !reFindNoCase( "^https?://[^/\s]", arguments.target ) ) {
			throw( type = "Feeds.FetchError", message = "Only http and https URLs can be fetched" )
		}
		if ( !( arguments.config.allowPrivateAddresses ?: false ) ) {
			requirePublicHost( arguments.target )
		}
		var remaining = remainingMs( arguments.deadline )
		var address = arguments.target
		var connection = overNetwork( () => createObject( "java", "java.net.URI" ).init( address ).toURL().openConnection() )
		connection.setInstanceFollowRedirects( false )
		connection.setConnectTimeout( remaining )
		connection.setReadTimeout( remaining )
		connection.setRequestProperty( "User-Agent", arguments.config.userAgent )
		connection.setRequestProperty( "Accept", len( arguments.config.accept ?: "" ) ? arguments.config.accept : static.ACCEPT )
		connection.setRequestProperty( "Accept-Encoding", "gzip" )
		if ( len( arguments.config.etag ?: "" ) ) {
			connection.setRequestProperty( "If-None-Match", arguments.config.etag )
		}
		if ( len( arguments.config.lastModified ?: "" ) ) {
			connection.setRequestProperty( "If-Modified-Since", arguments.config.lastModified )
		}
		return connection
	}

	/** The response body as bytes, gzip undone, given up on past maxBytes or the deadline. */
	private function bodyOf( required connection, required numeric maxBytes, required numeric deadline ) {
		var connection = arguments.connection
		var limit = arguments.maxBytes
		var until = arguments.deadline
		if ( connection.getContentLengthLong() > limit ) {
			tooLarge( limit )
		}
		return overNetwork( () => {
			var stream = connection.getInputStream()
			if ( lcase( connection.getContentEncoding() ?: "" ) == "gzip" ) {
				stream = createObject( "java", "java.util.zip.GZIPInputStream" ).init( stream )
			}
			var body = createObject( "java", "java.io.ByteArrayOutputStream" ).init()
			var chunk = createObject( "java", "java.nio.ByteBuffer" ).allocate( 16384 ).array()
			try {
				while ( true ) {
					var count = stream.read( chunk )
					if ( count < 0 ) {
						break
					}
					body.write( chunk, 0, count )
					if ( body.size() > limit ) {
						tooLarge( limit )
					}
					remainingMs( until )
				}
			} finally {
				stream.close()
			}
			return body.toByteArray()
		} )
	}

	/**
	 * Every address the host resolves to must be public: Feeds.FetchError.PrivateAddress
	 * otherwise. The JVM caches the lookup (30s by default), so the connection that
	 * follows normally uses the addresses that were checked.
	 */
	private void function requirePublicHost( required string target ) {
		var host = ""
		var addresses = []
		try {
			host = createObject( "java", "java.net.URI" ).init( arguments.target ).getHost() ?: ""
			addresses = createObject( "java", "java.net.InetAddress" ).getAllByName( host )
		} catch ( any e ) {
			throw( type = "Feeds.FetchError", message = "The feed couldn't be fetched", detail = "Unknown host: #host#" )
		}
		for ( var address in addresses ) {
			if ( !isPublicAddress( address ) ) {
				throw( type = "Feeds.FetchError.PrivateAddress", message = "#host# is not a public address" )
			}
		}
	}

	/**
	 * Whether a java.net.InetAddress is one on the public internet: not loopback,
	 * link-local, private, carrier-grade NAT, reserved, or an IPv6 form that
	 * carries or tunnels to such an IPv4 address. InetAddress hands IPv4-mapped
	 * IPv6 (::ffff:a.b.c.d) back as IPv4, so those are covered.
	 */
	boolean function isPublicAddress( required address ) {
		var a = arguments.address
		if ( a.isAnyLocalAddress() || a.isLoopbackAddress() || a.isLinkLocalAddress() || a.isSiteLocalAddress() || a.isMulticastAddress() ) {
			return false
		}
		var bytes = a.getAddress()
		var unsigned = []
		for ( var b in bytes ) {
			unsigned.append( bitAnd( b, 255 ) )
		}
		if ( unsigned.len() == 4 ) {
			return !(
				unsigned[ 1 ] == 0                                                    // "this network"
				|| ( unsigned[ 1 ] == 100 && bitAnd( unsigned[ 2 ], 192 ) == 64 )     // 100.64/10 carrier-grade NAT
				|| ( unsigned[ 1 ] == 192 && unsigned[ 2 ] == 0 && unsigned[ 3 ] == 0 ) // 192.0.0/24
				|| ( unsigned[ 1 ] == 198 && bitAnd( unsigned[ 2 ], 254 ) == 18 )     // 198.18/15 benchmarking
				|| unsigned[ 1 ] >= 240                                               // reserved and broadcast
			)
		}
		// fc00::/7 unique local; fec0::/10 is site-local, caught above
		if ( bitAnd( unsigned[ 1 ], 254 ) == 252 ) {
			return false
		}
		// IPv6 that carries an IPv4 address is judged by that address, so a private one can't ride along
		var arrays = createObject( "java", "java.util.Arrays" )
		var inet = createObject( "java", "java.net.InetAddress" )
		// 64:ff9b::/96, NAT64's well-known prefix: the last four bytes
		if ( unsigned[ 1 ] == 0 && unsigned[ 2 ] == 100 && unsigned[ 3 ] == 255 && unsigned[ 4 ] == 155 ) {
			if ( unsigned[ 5 ] == 0 && unsigned[ 6 ] == 1 ) {
				// 64:ff9b:1::/48, local-use NAT64: whatever it maps to is the network's own
				return false
			}
			if ( unsigned.slice( 5, 8 ).every( ( v ) => v == 0 ) ) {
				return isPublicAddress( inet.getByAddress( arrays.copyOfRange( bytes, 12, 16 ) ) )
			}
		}
		// 2002::/16, 6to4: bytes 3 to 6
		if ( unsigned[ 1 ] == 32 && unsigned[ 2 ] == 2 ) {
			return isPublicAddress( inet.getByAddress( arrays.copyOfRange( bytes, 2, 6 ) ) )
		}
		// 2001::/32, Teredo: tunnels to an address it obscures, never a feed's server
		if ( unsigned[ 1 ] == 32 && unsigned[ 2 ] == 1 && unsigned[ 3 ] == 0 && unsigned[ 4 ] == 0 ) {
			return false
		}
		return true
	}

	/**
	 * Some servers redirect to https://host:443/...; that's the same address as
	 * https://host/..., and stored with the port it would count as another feed.
	 */
	string function withoutDefaultPort( required string address ) {
		try {
			var u = createObject( "java", "java.net.URI" ).init( arguments.address )
			var scheme = lcase( u.getScheme() ?: "" )
			if ( isNull( u.getHost() ) || !( ( scheme == "https" && u.getPort() == 443 ) || ( scheme == "http" && u.getPort() == 80 ) ) ) {
				return arguments.address
			}
			// from the raw parts: the decoding constructors would turn an escaped & (%26) into a real one
			return u.getScheme() & "://"
				& ( isNull( u.getRawUserInfo() ) ? "" : u.getRawUserInfo() & "@" )
				& u.getHost()
				& ( u.getRawPath() ?: "" )
				& ( isNull( u.getRawQuery() ) ? "" : "?" & u.getRawQuery() )
				& ( isNull( u.getRawFragment() ) ? "" : "##" & u.getRawFragment() )
		} catch ( any e ) {
			return arguments.address
		}
	}

	/** Retry-After as seconds from now, whether it was sent as seconds or as a date; 0 when it's absent or unreadable. */
	private numeric function retryAfter( required string value ) {
		var written = trim( arguments.value )
		if ( reFind( "^[0-9]{1,9}$", written ) ) {
			return int( written )
		}
		if ( len( written ) ) {
			try {
				var until = createObject( "java", "java.time.ZonedDateTime" ).parse( written, createObject( "java", "java.time.format.DateTimeFormatter" ).RFC_1123_DATE_TIME )
				return max( 0, int( until.toEpochSecond() - getTickCount() / 1000 ) )
			} catch ( any e ) {
				// not a date either
			}
		}
		return 0
	}

	/**
	 * How long the server says its answer stays fresh, in seconds: Cache-Control's
	 * max-age, else the time left until Expires. 0 when it says neither, or says
	 * no-cache or no-store.
	 */
	private numeric function maxAge( required string cacheControl, required string expires ) {
		var control = lcase( arguments.cacheControl )
		if ( reFind( "\bno-(cache|store)\b", control ) ) {
			return 0
		}
		var age = reMatch( "\bmax-age\s*=\s*""?[0-9]{1,9}", control )
		if ( age.len() ) {
			return int( reReplace( age[ 1 ], "[^0-9]", "", "all" ) )
		}
		return retryAfter( reFind( "^[0-9]+$", trim( arguments.expires ) ) ? "" : arguments.expires )
	}

	/** The response's Link headers (RFC 8288), where a feed can name its WebSub hub and itself: [ { url, rel } ], one per rel. */
	private array function linksOf( required connection, required string base ) {
		var found = []
		var values = arguments.connection.getHeaderFields().get( "Link" ) ?: arguments.connection.getHeaderFields().get( "link" ) ?: []
		for ( var value in values ) {
			var links = static.LINK.matcher( value )
			while ( links.find() ) {
				var rel = static.LINK_REL.matcher( links.group( 2 ) )
				var rels = rel.find() ? ( rel.group( 1 ) ?: rel.group( 2 ) ) : ""
				for ( var name in listToArray( lcase( rels ), " " ) ) {
					found.append( { url: variables.parser.resolveUrl( links.group( 1 ), arguments.base ), rel: name } )
				}
			}
		}
		return found
	}

	/** Milliseconds left before the deadline; Feeds.FetchError.Timeout when there are none. */
	private numeric function remainingMs( required numeric deadline ) {
		var remaining = arguments.deadline - getTickCount()
		if ( remaining <= 0 ) {
			throw( type = "Feeds.FetchError.Timeout", message = "The feed took too long to answer" )
		}
		return int( remaining )
	}

	private void function tooLarge( required numeric maxBytes ) {
		throw( type = "Feeds.FetchError.TooLarge", message = "The feed is larger than #arguments.maxBytes# bytes" )
	}

	/** Runs a network call, turning what Java throws into Feeds.FetchError (a timeout into Feeds.FetchError.Timeout). */
	private function overNetwork( required function call ) {
		try {
			return arguments.call()
		} catch ( "Feeds.FetchError" e ) {
			rethrow;
		} catch ( any e ) {
			var cause = isInstanceOf( e, "java.lang.Throwable" ) ? e : ( e.cause ?: javacast( "null", "" ) )
			var depth = 0
			var reason = e.message ?: ""
			while ( !isNull( cause ) && depth < 10 ) {
				if ( isInstanceOf( cause, "java.net.SocketTimeoutException" ) ) {
					throw( type = "Feeds.FetchError.Timeout", message = "The feed took too long to answer" )
				}
				if ( isInstanceOf( cause, "java.io.IOException" ) ) {
					reason = cause.getClass().getSimpleName() & ": " & ( cause.getMessage() ?: "" )
				}
				cause = cause.getCause()
				depth++
			}
			throw( type = "Feeds.FetchError", message = "The feed couldn't be fetched", detail = reason )
		}
	}

}
