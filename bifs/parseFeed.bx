/**
 * Parses an RSS, Atom or JSON Feed document into one normalized struct.
 * input: the feed as a string, as bytes, or the path of a file.
 *
 *   feed = parseFeed( fileReadBinary( "feed.xml" ), { baseUrl: "https://example.com/feed.xml" } )
 *   for ( item in feed.items ) println( item.id & " " & item.title )
 */
@BoxBIF
class {

	function invoke( required input, struct options = {} ) {
		return new bxModules.bxFeeds.models.FeedParser().parse( arguments.input, arguments.options )
	}

}
