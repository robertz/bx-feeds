/** fetchFeed() against a local server on a random port: no spec touches the network. */
class extends="testbox.system.BaseSpec" {

	function fixture( required string name ) {
		return fileReadBinary( getDirectoryFromPath( getCurrentTemplatePath() ) & "../resources/" & arguments.name )
	}

	function gzipped( required bytes ) {
		var out = createObject( "java", "java.io.ByteArrayOutputStream" ).init()
		var gzip = createObject( "java", "java.util.zip.GZIPOutputStream" ).init( out )
		gzip.write( arguments.bytes )
		gzip.close()
		return out.toByteArray()
	}

	function beforeAll() {
		variables.fetcher = new bxModules.bxFeeds.models.FeedFetcher( { allowPrivateAddresses: true } )
		variables.feeds = new tests.helpers.FeedServer()
		var rss = fixture( "rss20.xml" )
		var messy = fixture( "messy.xml" )
		var feeds = variables.feeds
		var big = repeatString( "<!-- padding padding padding padding -->", 5000 )

		feeds.on( "/feed.xml", ( headers ) => {
			var unchanged = ( headers[ "If-None-Match" ] ?: "" ) == '"v1"' || ( headers[ "If-Modified-Since" ] ?: "" ) == "Tue, 03 Nov 2026 09:30:00 GMT"
			return {
				status  : unchanged ? 304 : 200,
				headers : { "ETag": '"v1"', "Last-Modified": "Tue, 03 Nov 2026 09:30:00 GMT", "Content-Type": "application/rss+xml; charset=utf-8" },
				body    : unchanged ? "" : rss
			}
		} )
		feeds.on( "/bare-304", ( headers ) => { return { status: 304 } } )
		feeds.on( "/blog/messy.xml", ( headers ) => { return { status: 200, body: messy } } )
		feeds.on( "/moved", ( headers ) => { return { status: 301, headers: { "Location": feeds.at( "/feed.xml" ) } } } )
		feeds.on( "/moved-308", ( headers ) => { return { status: 308, headers: { "Location": "/feed.xml" } } } )
		feeds.on( "/moved-twice", ( headers ) => { return { status: 301, headers: { "Location": "/moved" } } } )
		feeds.on( "/temporary", ( headers ) => { return { status: 302, headers: { "Location": "/feed.xml" } } } )
		feeds.on( "/temporary-307", ( headers ) => { return { status: 307, headers: { "Location": "/feed.xml" } } } )
		feeds.on( "/moved-then-temporary", ( headers ) => { return { status: 301, headers: { "Location": "/temporary" } } } )
		feeds.on( "/temporary-then-moved", ( headers ) => { return { status: 302, headers: { "Location": "/moved" } } } )
		feeds.on( "/loop", ( headers ) => { return { status: 302, headers: { "Location": "/loop" } } } )
		feeds.on( "/to-file", ( headers ) => { return { status: 302, headers: { "Location": "file:///etc/hosts" } } } )
		feeds.on( "/big", ( headers ) => { return { status: 200, body: "<rss version=""2.0""><channel><title>Big</title>#big#</channel></rss>" } } )
		feeds.on( "/big-chunked", ( headers ) => { return { status: 200, chunked: true, body: "<rss version=""2.0""><channel><title>Big</title>#big#</channel></rss>" } } )
		feeds.on( "/gzip", ( headers ) => { return { status: 200, headers: { "Content-Encoding": "gzip" }, body: gzipped( rss ) } } )
		feeds.on( "/gzip-bomb", ( headers ) => { return { status: 200, headers: { "Content-Encoding": "gzip" }, body: gzipped( "<rss version=""2.0""><channel><title>Bomb</title>#big#</channel></rss>".getBytes( "UTF-8" ) ) } } )
		feeds.on( "/slow", ( headers ) => { return { status: 200, delayMs: 3000, body: rss } } )
		feeds.on( "/drip", ( headers ) => { return { status: 200, dripMs: 100, body: rss } } )
		feeds.on( "/gone", ( headers ) => { return { status: 410, body: "Gone" } } )
		feeds.on( "/error", ( headers ) => { return { status: 500, body: "<html>Oops</html>" } } )
		feeds.on( "/html", ( headers ) => { return { status: 200, headers: { "Content-Type": "text/html" }, body: "<!doctype html><html><body>Sign in</body></html>" } } )
		feeds.on( "/fresh", ( headers ) => { return { status: 200, headers: { "Cache-Control": "public, max-age=900, s-maxage=60" }, body: rss } } )
		feeds.on( "/fresh-until", ( headers ) => {
			var later = createObject( "java", "java.time.ZonedDateTime" ).now( createObject( "java", "java.time.ZoneOffset" ).UTC ).plusMinutes( 30 )
			return { status: 200, headers: { "Expires": createObject( "java", "java.time.format.DateTimeFormatter" ).RFC_1123_DATE_TIME.format( later ) }, body: rss }
		} )
		feeds.on( "/stale", ( headers ) => { return { status: 200, headers: { "Cache-Control": "no-cache, max-age=900", "Expires": "0" }, body: rss } } )
		feeds.on( "/expired", ( headers ) => { return { status: 200, headers: { "Expires": "Thu, 01 Jan 2015 00:00:00 GMT" }, body: rss } } )
		feeds.on( "/hostile", ( headers ) => { return { status: 200, body: fixture( "hostile-urls.xml" ) } } )
		feeds.on( "/busy", ( headers ) => { return { status: 429, headers: { "Retry-After": "120" } } } )
		feeds.on( "/busy-until", ( headers ) => {
			var later = createObject( "java", "java.time.ZonedDateTime" ).now( createObject( "java", "java.time.ZoneOffset" ).UTC ).plusMinutes( 10 )
			return { status: 503, headers: { "Retry-After": createObject( "java", "java.time.format.DateTimeFormatter" ).RFC_1123_DATE_TIME.format( later ) } }
		} )
		feeds.on( "/busy-nonsense", ( headers ) => { return { status: 429, headers: { "Retry-After": "soon" } } } )
		feeds.on( "/linked", ( headers ) => {
			return { status: 200, headers: { "Link": '<https://hub.example/>; rel="hub", </feed.xml>; rel="self alternate"; type="application/rss+xml", <https://no-rel.example/>' }, body: rss }
		} )
		feeds.on( "/image.png", ( headers ) => { return { status: 200, headers: { "Content-Type": "image/png" }, body: fixture( "garbage.bin" ) } } )
		feeds.on( "/latin1", ( headers ) => {
			return { status: 200, headers: { "Content-Type": "text/xml; charset=ISO-8859-1" }, body: "<rss version=""2.0""><channel><title>Caf#char( 233 )#</title></channel></rss>".getBytes( "ISO-8859-1" ) }
		} )
	}

	function afterAll() {
		variables.feeds.stop()
	}

	function run() {

		describe( "FeedFetcher", () => {

			describe( "a plain fetch", () => {

				it( "returns the parsed feed with its validators", () => {
					var result = fetcher.fetch( feeds.at( "/feed.xml" ) )
					expect( result.status ).toBe( 200 )
					expect( result.notModified ).toBeFalse()
					expect( result.etag ).toBe( '"v1"' )
					expect( result.lastModified ).toBe( "Tue, 03 Nov 2026 09:30:00 GMT" )
					expect( result.finalUrl ).toBe( feeds.at( "/feed.xml" ) )
					expect( result.permanentUrl ).toBe( "" )
					expect( result.feed.title ).toBe( "Example Blog" )
					expect( result.feed.items.len() ).toBe( 2 )
				} )

				it( "says who's asking and what it takes", () => {
					fetcher.fetch( feeds.at( "/feed.xml" ) )
					var sent = feeds.hits( "/feed.xml" ).last().headers
					expect( sent[ "User-Agent" ] ).toBe( getModuleInfo( "bxFeeds" ).settings.userAgent )
					expect( sent[ "Accept" ] ).toInclude( "application/atom+xml" )
					expect( sent[ "Accept-Encoding" ] ).toBe( "gzip" )
					expect( sent.keyExists( "If-None-Match" ) ).toBeFalse()
					expect( sent.keyExists( "If-Modified-Since" ) ).toBeFalse()
				} )

				it( "sends the User-Agent it's given, per call or per fetcher", () => {
					fetcher.fetch( feeds.at( "/feed.xml" ), { userAgent: "Feedhouse/1.0 (+https://feedhouse.app)" } )
					expect( feeds.hits( "/feed.xml" ).last().headers[ "User-Agent" ] ).toBe( "Feedhouse/1.0 (+https://feedhouse.app)" )
					new bxModules.bxFeeds.models.FeedFetcher( { userAgent: "Mine/2", allowPrivateAddresses: true } ).fetch( feeds.at( "/feed.xml" ) )
					expect( feeds.hits( "/feed.xml" ).last().headers[ "User-Agent" ] ).toBe( "Mine/2" )
				} )

				it( "resolves relative links against where the feed was fetched", () => {
					var feed = fetcher.fetch( feeds.at( "/blog/messy.xml" ) ).feed
					expect( feed.link ).toBe( feeds.at( "/" ) )
					expect( feed.items[ 1 ].link ).toBe( feeds.at( "/posts/one" ) )
				} )

				it( "reads the charset from the Content-Type header", () => {
					expect( fetcher.fetch( feeds.at( "/latin1" ) ).feed.title ).toBe( "Caf#char( 233 )#" )
				} )

				it( "undoes gzip", () => {
					expect( fetcher.fetch( feeds.at( "/gzip" ) ).feed.title ).toBe( "Example Blog" )
				} )

			} )

			describe( "a conditional GET", () => {

				it( "sends the ETag and gets a 304 with no feed", () => {
					var result = fetcher.fetch( feeds.at( "/feed.xml" ), { etag: '"v1"' } )
					expect( feeds.hits( "/feed.xml" ).last().headers[ "If-None-Match" ] ).toBe( '"v1"' )
					expect( result.status ).toBe( 304 )
					expect( result.notModified ).toBeTrue()
					expect( isNull( result.feed ) ).toBeTrue()
					expect( result.etag ).toBe( '"v1"' )
				} )

				it( "sends Last-Modified as If-Modified-Since", () => {
					var result = fetcher.fetch( feeds.at( "/feed.xml" ), { lastModified: "Tue, 03 Nov 2026 09:30:00 GMT" } )
					expect( feeds.hits( "/feed.xml" ).last().headers[ "If-Modified-Since" ] ).toBe( "Tue, 03 Nov 2026 09:30:00 GMT" )
					expect( result.notModified ).toBeTrue()
				} )

				it( "fetches again when the validators are stale", () => {
					var result = fetcher.fetch( feeds.at( "/feed.xml" ), { etag: '"v0"', lastModified: "Mon, 02 Nov 2026 00:00:00 GMT" } )
					expect( result.status ).toBe( 200 )
					expect( result.etag ).toBe( '"v1"' )
					expect( result.feed.title ).toBe( "Example Blog" )
				} )

				it( "hands back the validators it was given when a 304 repeats none", () => {
					var result = fetcher.fetch( feeds.at( "/bare-304" ), { etag: '"kept"', lastModified: "Sun, 01 Nov 2026 00:00:00 GMT" } )
					expect( result.notModified ).toBeTrue()
					expect( result.etag ).toBe( '"kept"' )
					expect( result.lastModified ).toBe( "Sun, 01 Nov 2026 00:00:00 GMT" )
				} )

				it( "round-trips: what one fetch returns makes the next a 304", () => {
					var first = fetcher.fetch( feeds.at( "/feed.xml" ) )
					var second = fetcher.fetch( feeds.at( "/feed.xml" ), { etag: first.etag, lastModified: first.lastModified } )
					expect( second.notModified ).toBeTrue()
				} )

			} )

			describe( "redirects", () => {

				it( "follows a 301 and reports where the feed moved", () => {
					var result = fetcher.fetch( feeds.at( "/moved" ) )
					expect( result.status ).toBe( 200 )
					expect( result.finalUrl ).toBe( feeds.at( "/feed.xml" ) )
					expect( result.permanentUrl ).toBe( feeds.at( "/feed.xml" ) )
					expect( result.feed.title ).toBe( "Example Blog" )
				} )

				it( "treats a 308 the same, and resolves a relative Location", () => {
					var result = fetcher.fetch( feeds.at( "/moved-308" ) )
					expect( result.permanentUrl ).toBe( feeds.at( "/feed.xml" ) )
				} )

				it( "follows a 302 or 307 without calling it permanent", () => {
					for ( var path in [ "/temporary", "/temporary-307" ] ) {
						var result = fetcher.fetch( feeds.at( path ) )
						expect( result.status ).toBe( 200 )
						expect( result.finalUrl ).toBe( feeds.at( "/feed.xml" ) )
						expect( result.permanentUrl ).toBe( "" )
					}
				} )

				it( "reports the end of a chain of permanent redirects", () => {
					expect( fetcher.fetch( feeds.at( "/moved-twice" ) ).permanentUrl ).toBe( feeds.at( "/feed.xml" ) )
				} )

				it( "reports only as far as the redirects stay permanent", () => {
					var result = fetcher.fetch( feeds.at( "/moved-then-temporary" ) )
					expect( result.finalUrl ).toBe( feeds.at( "/feed.xml" ) )
					expect( result.permanentUrl ).toBe( feeds.at( "/temporary" ) )
					expect( fetcher.fetch( feeds.at( "/temporary-then-moved" ) ).permanentUrl ).toBe( "" )
				} )

				it( "keeps the validators across a redirect", () => {
					var result = fetcher.fetch( feeds.at( "/moved" ), { etag: '"v1"' } )
					expect( result.notModified ).toBeTrue()
					expect( result.permanentUrl ).toBe( feeds.at( "/feed.xml" ) )
				} )

				it( "gives up on a redirect loop", () => {
					var before = feeds.hits( "/loop" ).len()
					expect( () => fetcher.fetch( feeds.at( "/loop" ) ) ).toThrow( type = "Feeds.FetchError.TooManyRedirects" )
					// the first request and maxRedirects more
					expect( feeds.hits( "/loop" ).len() - before ).toBe( 6 )
					expect( () => fetcher.fetch( feeds.at( "/moved-twice" ), { maxRedirects: 1 } ) ).toThrow( type = "Feeds.FetchError.TooManyRedirects" )
				} )

				it( "won't follow a redirect off http(s)", () => {
					expect( () => fetcher.fetch( feeds.at( "/to-file" ) ) ).toThrow( type = "Feeds.FetchError" )
				} )

			} )

			describe( "limits", () => {

				it( "refuses a response over maxBytes by its Content-Length", () => {
					expect( () => fetcher.fetch( feeds.at( "/big" ), { maxBytes: 50000 } ) ).toThrow( type = "Feeds.FetchError.TooLarge" )
				} )

				it( "stops reading a response of unknown length at maxBytes", () => {
					expect( () => fetcher.fetch( feeds.at( "/big-chunked" ), { maxBytes: 50000 } ) ).toThrow( type = "Feeds.FetchError.TooLarge" )
				} )

				it( "counts the bytes after gzip is undone", () => {
					expect( () => fetcher.fetch( feeds.at( "/gzip-bomb" ), { maxBytes: 50000 } ) ).toThrow( type = "Feeds.FetchError.TooLarge" )
				} )

				it( "takes a response under maxBytes", () => {
					expect( fetcher.fetch( feeds.at( "/big" ), { maxBytes: 500000 } ).feed.title ).toBe( "Big" )
				} )

				it( "times out on a server that's slow to answer", () => {
					var started = getTickCount()
					expect( () => fetcher.fetch( feeds.at( "/slow" ), { timeoutSeconds: 1 } ) ).toThrow( type = "Feeds.FetchError.Timeout" )
					expect( getTickCount() - started ).toBeLT( 2500 )
				} )

				it( "times out on a body that trickles in, however regularly", () => {
					var started = getTickCount()
					expect( () => fetcher.fetch( feeds.at( "/drip" ), { timeoutSeconds: 1 } ) ).toThrow( type = "Feeds.FetchError.Timeout" )
					expect( getTickCount() - started ).toBeLT( 2500 )
				} )

				it( "can be caught as Feeds.FetchError whatever the limit", () => {
					var caught = []
					for ( var call in [ { path: "/big", options: { maxBytes: 50000 } }, { path: "/slow", options: { timeoutSeconds: 1 } }, { path: "/loop", options: {} } ] ) {
						try {
							fetcher.fetch( feeds.at( call.path ), call.options )
						} catch ( "Feeds.FetchError" e ) {
							caught.append( e.type )
						}
					}
					expect( caught ).toBe( [ "Feeds.FetchError.TooLarge", "Feeds.FetchError.Timeout", "Feeds.FetchError.TooManyRedirects" ] )
				} )

			} )

			describe( "what else the response says", () => {

				it( "reports Retry-After in seconds, sent as seconds or as a date", () => {
					var busy = fetcher.fetch( feeds.at( "/busy" ) )
					expect( busy.status ).toBe( 429 )
					expect( busy.retryAfterSeconds ).toBe( 120 )
					var until = fetcher.fetch( feeds.at( "/busy-until" ) ).retryAfterSeconds
					expect( until ).toBeGT( 590 )
					expect( until ).toBeLTE( 600 )
					expect( fetcher.fetch( feeds.at( "/busy-nonsense" ) ).retryAfterSeconds ).toBe( 0 )
					expect( fetcher.fetch( feeds.at( "/feed.xml" ) ).retryAfterSeconds ).toBe( 0 )
				} )

				it( "reports how long the answer stays fresh: max-age, else Expires", () => {
					expect( fetcher.fetch( feeds.at( "/fresh" ) ).maxAgeSeconds ).toBe( 900 )
					var until = fetcher.fetch( feeds.at( "/fresh-until" ) ).maxAgeSeconds
					expect( until ).toBeGT( 1790 )
					expect( until ).toBeLTE( 1800 )
					expect( fetcher.fetch( feeds.at( "/stale" ) ).maxAgeSeconds ).toBe( 0 )
					expect( fetcher.fetch( feeds.at( "/expired" ) ).maxAgeSeconds ).toBe( 0 )
					expect( fetcher.fetch( feeds.at( "/feed.xml" ) ).maxAgeSeconds ).toBe( 0 )
				} )

				it( "passes the parser's options on", () => {
					var feed = fetcher.fetch( feeds.at( "/hostile" ), { httpOnly: true, collapseRevisions: true, maxItems: 2 } ).feed
					expect( feed.link ).toBe( "" )
					expect( feed.items.len() ).toBe( 2 )
					expect( feed.items[ 2 ].id ).toBe( "https://news.example/story" )
					// where it was fetched from still wins over a baseUrl in the options
					expect( fetcher.fetch( feeds.at( "/blog/messy.xml" ), { baseUrl: "https://elsewhere.example/" } ).feed.items[ 1 ].link ).toBe( feeds.at( "/posts/one" ) )
				} )

				it( "reports the Link header's hub and self, resolved", () => {
					var result = fetcher.fetch( feeds.at( "/linked" ) )
					expect( result.links ).toBe( [
						{ url: "https://hub.example/", rel: "hub" },
						{ url: feeds.at( "/feed.xml" ), rel: "self" },
						{ url: feeds.at( "/feed.xml" ), rel: "alternate" }
					] )
					expect( fetcher.fetch( feeds.at( "/feed.xml" ) ).links ).toBeEmpty()
				} )

				it( "reports the content type", () => {
					expect( fetcher.fetch( feeds.at( "/feed.xml" ) ).contentType ).toBe( "application/rss+xml; charset=utf-8" )
				} )

				it( "returns the bytes instead of a feed when asked not to parse", () => {
					var result = fetcher.fetch( feeds.at( "/image.png" ), { parse: false } )
					expect( result.status ).toBe( 200 )
					expect( isNull( result.feed ) ).toBeTrue()
					expect( isBinary( result.body ) ).toBeTrue()
					expect( arrayLen( result.body ) ).toBe( arrayLen( fixture( "garbage.bin" ) ) )
					expect( result.contentType ).toBe( "image/png" )
					expect( isNull( fetcher.fetch( feeds.at( "/feed.xml" ) ).body ) ).toBeTrue()
					expect( isNull( fetcher.fetch( feeds.at( "/gone" ), { parse: false } ).body ) ).toBeTrue()
					expect( () => fetcher.fetch( feeds.at( "/big" ), { parse: false, maxBytes: 50000 } ) ).toThrow( type = "Feeds.FetchError.TooLarge" )
				} )

				it( "drops a default port, so the address is the one people type", () => {
					expect( fetcher.withoutDefaultPort( "https://example.com:443/feed.xml?a=1%26b##top" ) ).toBe( "https://example.com/feed.xml?a=1%26b##top" )
					expect( fetcher.withoutDefaultPort( "http://example.com:80/" ) ).toBe( "http://example.com/" )
					expect( fetcher.withoutDefaultPort( "http://example.com:443/" ) ).toBe( "http://example.com:443/" )
					expect( fetcher.withoutDefaultPort( "https://example.com:8443/x" ) ).toBe( "https://example.com:8443/x" )
					expect( fetcher.withoutDefaultPort( "https://example.com/x" ) ).toBe( "https://example.com/x" )
				} )

			} )

			describe( "private addresses", () => {

				it( "refuses them by default, before connecting", () => {
					var careful = new bxModules.bxFeeds.models.FeedFetcher()
					var before = feeds.hits().len()
					expect( () => careful.fetch( feeds.at( "/feed.xml" ) ) ).toThrow( type = "Feeds.FetchError.PrivateAddress" )
					expect( feeds.hits().len() ).toBe( before )
					for ( var address in [ "http://localhost/feed", "http://10.0.0.1/feed", "http://192.168.1.1/", "http://169.254.169.254/latest/meta-data/", "http://[::1]/feed", "http://0.0.0.0/", "http://[::ffff:127.0.0.1]/" ] ) {
						expect( () => careful.fetch( address ) ).toThrow( type = "Feeds.FetchError.PrivateAddress" )
					}
				} )

				it( "can be caught as Feeds.FetchError", () => {
					try {
						fetchFeed( feeds.at( "/feed.xml" ) )
						fail( "should have thrown" )
					} catch ( "Feeds.FetchError" e ) {
						expect( e.type ).toBe( "Feeds.FetchError.PrivateAddress" )
						expect( e.message ).toBe( "127.0.0.1 is not a public address" )
					}
				} )

				it( "allows them when told to, per call or per fetcher", () => {
					expect( fetchFeed( feeds.at( "/feed.xml" ), { allowPrivateAddresses: true } ).status ).toBe( 200 )
					expect( fetcher.fetch( feeds.at( "/feed.xml" ) ).status ).toBe( 200 )
				} )

				it( "treats only public addresses as public", () => {
					var inet = createObject( "java", "java.net.InetAddress" )
					for ( var literal in [ "8.8.8.8", "1.1.1.1", "93.184.216.34", "2606:4700:4700::1111", "64:ff9b::808:808", "2002:808:808::1" ] ) {
						expect( fetcher.isPublicAddress( inet.getByName( literal ) ) ).toBeTrue( literal )
					}
					for ( var literal in [
						"127.0.0.1", "127.8.8.8", "10.1.2.3", "172.16.0.1", "172.31.255.255", "192.168.0.1", "169.254.169.254", "0.0.0.0", "0.1.2.3",
						"100.64.0.1", "100.127.255.255", "192.0.0.1", "198.18.0.1", "198.19.255.255", "224.0.0.1", "240.0.0.1", "255.255.255.255",
						"::1", "::", "fe80::1", "fc00::1", "fd12:3456::1", "fec0::1", "ff02::1", "::ffff:10.0.0.1", "::ffff:127.0.0.1",
						"64:ff9b::a00:1", "64:ff9b::7f00:1", "64:ff9b:1::808:808", "2002:a00:1::1", "2002:7f00:1::1", "2001:0:4136:e378:8000:63bf:3fff:fdd2"
					] ) {
						expect( fetcher.isPublicAddress( inet.getByName( literal ) ) ).toBeFalse( literal )
					}
				} )

			} )

			describe( "failures", () => {

				it( "returns the status of a 4xx or 5xx, with no feed", () => {
					var gone = fetcher.fetch( feeds.at( "/gone" ) )
					expect( gone.status ).toBe( 410 )
					expect( gone.notModified ).toBeFalse()
					expect( isNull( gone.feed ) ).toBeTrue()
					expect( fetcher.fetch( feeds.at( "/error" ) ).status ).toBe( 500 )
					expect( fetcher.fetch( feeds.at( "/nothing-here" ) ).status ).toBe( 404 )
				} )

				it( "throws Feeds.ParseError for a 200 that isn't a feed", () => {
					expect( () => fetcher.fetch( feeds.at( "/html" ) ) ).toThrow( type = "Feeds.ParseError" )
				} )

				it( "throws Feeds.FetchError when nothing answers", () => {
					var closed = new tests.helpers.FeedServer()
					var address = closed.at( "/feed.xml" )
					closed.stop()
					expect( () => fetcher.fetch( address, { timeoutSeconds: 2 } ) ).toThrow( type = "Feeds.FetchError" )
					expect( () => fetcher.fetch( "http://no-such-host.invalid/feed.xml" ) ).toThrow( type = "Feeds.FetchError" )
					expect( () => new bxModules.bxFeeds.models.FeedFetcher().fetch( "http://no-such-host.invalid/feed.xml" ) ).toThrow( type = "Feeds.FetchError" )
				} )

				it( "throws Feeds.FetchError for anything but http(s)", () => {
					expect( () => fetcher.fetch( "file:///etc/hosts" ) ).toThrow( type = "Feeds.FetchError" )
					expect( () => fetcher.fetch( "ftp://example.com/feed.xml" ) ).toThrow( type = "Feeds.FetchError" )
					expect( () => fetcher.fetch( "not a url" ) ).toThrow( type = "Feeds.FetchError" )
					expect( () => fetcher.fetch( "" ) ).toThrow( type = "Feeds.FetchError" )
				} )

			} )

		} )

	}

}
