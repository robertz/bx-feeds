<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns="http://purl.org/rss/1.0/">
	<channel rdf:about="https://text.example/index.rdf">
		<title>Text and not</title>
		<link>https://text.example/</link>
		<description>Descriptions that are plain text by the spec</description>
		<items><rdf:Seq><rdf:li rdf:resource="https://text.example/1"/><rdf:li rdf:resource="https://text.example/2"/></rdf:Seq></items>
	</channel>
	<item rdf:about="https://text.example/1">
		<title>HTML anyway</title>
		<link>https://text.example/1</link>
		<description>A tool lets you clear space from your drive.

It then &lt;a href="/more"&gt;does more&lt;/a&gt;.
  
&lt;em&gt;Third&lt;/em&gt; paragraph.</description>
	</item>
	<item rdf:about="https://text.example/2">
		<title>Really text</title>
		<link>https://text.example/2</link>
		<description>Plain text, where 3 &lt; 4 and &lt;angle brackets&gt; are just words.
Same paragraph, next line.

A second paragraph.</description>
	</item>
</rdf:RDF>
